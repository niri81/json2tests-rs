{
  "testcases": {
    "test_addition": {
      "action": "add",
      "arguments": {
        "a": 2,
        "b": 3
      },
      "result": 5
    },
    "test_addition_fails": {
      "action": "add",
      "arguments": {
        "a": 2,
        "b": 3
      },
      "result": 4,
      "panic": true
    },
    "test_addition_fails_with_message": {
      "action": "add",
      "arguments": {
        "a": "a",
        "b": 3
      },
      "result": 4,
      "panic": "called `Option::unwrap()` on a `None` value"
    }
  }
}
